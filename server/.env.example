# Server configuration — copy this to .env and adjust as needed.
# .env is never committed to git.
#
# NON-DOCKER USE ONLY.
# Docker users: set all variables in the root .env (see .env.example).
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Comma-separated list of allowed CORS origins (your frontend URL).
CORS_ORIGINS=http://localhost:5173

# Path where uploaded data and config are stored (relative to server/).
DATA_PATH=./data

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# Enable strict HTTP security headers (recommended in production behind HTTPS).
ENABLE_HELMET=true

# Max login attempts per IP before blocking.
# Window is in milliseconds (900000 = 15 minutes).
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Maximum size per uploaded file in MB.
UPLOAD_LIMIT_MB=5000

# Set to false to remove all /admin/* routes entirely.
ADMIN_ENABLED=true
