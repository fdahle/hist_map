# ─────────────────────────────────────────────────────────────────────────────
# Stratum3D — root configuration file
#
# DOCKER USERS (recommended):
#   Copy this file to .env in this same folder and edit it.
#   Docker Compose reads this file and passes the values into the server
#   container and into the client build.
#
#     cp .env.example .env
#
# NON-DOCKER USERS (running server/client directly):
#   Configure the server via  server/.env  (copy from server/.env.example)
#   Configure the client via  client/.env  (copy from client/.env.example)
#   This root .env is NOT read by either process when not using Docker.
#
# PRIORITY ORDER for Docker (highest wins):
#   1. docker-compose.yml  environment:  section
#   2. This file  (.env)                           ← your main configuration
#   3. Default values hard-coded in the server
#
# ─────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────

# Port the backend API listens on inside the container.
# Also controls the host-side port mapping in docker-compose.yml.
PORT=3000

# Network interface to bind inside the container. 0.0.0.0 = all interfaces.
HOST=0.0.0.0

# Run mode. Use "production" for live deployments.
NODE_ENV=production

# Comma-separated list of URLs allowed to call the API (your frontend URL).
# Must match exactly what the browser shows in the address bar.
# Without a reverse proxy (direct access):  CORS_ORIGINS=http://your-host:8080
# Behind Apache/nginx (recommended):        CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=http://localhost:8080

# Where uploaded data and config are stored inside the container.
# Only change this if you also adjust the volume mount in docker-compose.yml.
DATA_PATH=./data

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# ── Security ──────────────────────────────────────────────────────────────────

# Enable strict HTTP security headers (recommended in production behind HTTPS).
ENABLE_HELMET=true

# Max login attempts per IP before blocking.
# Window is in milliseconds (900000 = 15 minutes).
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ── Uploads ───────────────────────────────────────────────────────────────────

# Maximum size per uploaded file in MB.
UPLOAD_LIMIT_MB=5000

# ── Admin panel ───────────────────────────────────────────────────────────────

# Set to false once your data is loaded and the site is locked down for public
# use. Strips ALL /admin/* routes from the server entirely — no login page, no
# attack surface.
ADMIN_ENABLED=true

# ── Client (baked into the frontend bundle at Docker build time) ──────────────

# Public URL of the backend API as seen from the browser.
# Without a reverse proxy (direct access):  VITE_API_URL=http://your-host:3000
# Behind Apache/nginx (recommended):        VITE_API_URL=https://your-domain.com/api
VITE_API_URL=http://localhost:3000

# Site title shown in the browser tab.
VITE_SITE_TITLE=Stratum3D

# Favicon path served from the client's public/ folder.
VITE_SITE_FAVICON=/favicon.svg

# Bug-report link in the UI.
# "auto"  — links to the default GitHub issue tracker
# a URL   — links to your own tracker
# "false" — hides the link entirely
VITE_BUG_REPORT=auto

# Enable verbose debug logging in the browser console. Keep false in production.
VITE_DEBUG_MODE=false

# Default theme for first-time visitors.
# "auto"  — follows the visitor's OS/browser dark-mode preference (recommended)
# "dark"  — always dark
# "light" — always light
VITE_DEFAULT_THEME=auto
