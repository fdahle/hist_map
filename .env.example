# ─────────────────────────────────────────────────────────────────────────────
# Stratum3D — root configuration file
#
# DOCKER USERS (recommended):
#   Copy this file to .env in this same folder and edit it.
#   This single file is all you need — Docker Compose injects these values
#   into the server container automatically.
#
#   cp .env.example .env
#
# NON-DOCKER USERS (running server/client directly):
#   Configure server/  via server/.env  (copy from server/.env.example)
#   Configure client/  via client/.env  (copy from client/.env.example)
#   This root .env file is ignored when not using Docker.
# ─────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────

# Port the backend API (Node.js/Express) listens on — this is NOT what users open in the browser.
# Also controls the host-side port mapping in docker-compose.yml (left side of "3000:3000").
PORT=3000

# Network interface to bind to. 0.0.0.0 means "all interfaces" — correct for Docker.
HOST=0.0.0.0

# Run mode. Use "production" for live deployments.
NODE_ENV=production

# Comma-separated list of URLs that are allowed to call the API (your frontend URL).
# This is port 8080 — the nginx container that serves the Vue app (what users open in the browser).
# Must match exactly what the browser shows in the address bar, including the port
# when it is non-standard (anything other than 80 for http or 443 for https).
#   Standard port (no port needed):  CORS_ORIGINS=https://maps.example.com
#   Non-standard port (port needed):  CORS_ORIGINS=http://maps.example.com:8080
CORS_ORIGINS=http://localhost:8080

# Where uploaded data and config are stored inside the container.
# Only change this if you also adjust the volume mount in docker-compose.yml.
DATA_PATH=./data

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# ── Security ──────────────────────────────────────────────────────────────────

# How many login attempts are allowed per IP before the server blocks further
# attempts. The window is in milliseconds (900000 = 15 minutes).
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ── Uploads ───────────────────────────────────────────────────────────────────

# Maximum size per uploaded file in MB.
UPLOAD_LIMIT_MB=5000

# ── Admin panel ───────────────────────────────────────────────────────────────

# Set to false once your data is loaded and the site is locked down for public
# use. This removes ALL /admin/* routes from the server entirely — no login
# page, no attack surface.
ADMIN_ENABLED=true

# ── Client ───────────────────────────────────────────────────────────────────

# Public URL of the backend API (port 3000) as seen from the browser.
# This is baked into the client JS bundle at build time by Vite.
# Must match the host/port where the server container is publicly reachable.
# Example: VITE_API_URL=http://your-domain.com:3000
VITE_API_URL=http://localhost:3000

# Default theme for first-time visitors (before they change it in settings).
# "auto"  — follows the visitor's OS/browser dark-mode preference (recommended)
# "dark"  — always start in dark mode
# "light" — always start in light mode
VITE_DEFAULT_THEME=auto
