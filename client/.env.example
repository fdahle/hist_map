# Client configuration — copy this to .env and adjust as needed.
# .env is never committed to git.
# All variables must be prefixed with VITE_ to be exposed to the browser.
#
# NON-DOCKER USE ONLY.
# Docker users: set all variables in the root .env (see .env.example).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the backend API as seen from the browser.
VITE_API_URL=http://localhost:3000

# Site title shown in the browser tab.
VITE_SITE_TITLE=Stratum3D

# Favicon path served from the public/ folder.
VITE_SITE_FAVICON=/favicon.svg

# Bug-report link in the UI.
# "auto"  — links to the default GitHub issue tracker
# a URL   — links to your own tracker
# "false" — hides the link entirely
VITE_BUG_REPORT=auto

# Enable verbose debug logging in the browser console. Keep false in production.
VITE_DEBUG_MODE=false

# Default theme for first-time visitors.
# "auto"  — follows the visitor's OS/browser dark-mode preference (recommended)
# "dark"  — always dark
# "light" — always light
VITE_DEFAULT_THEME=auto
