# Client configuration — copy this to .env and adjust as needed.
# .env is never committed to git.
# All variables must be prefixed with VITE_ to be exposed to the browser.

# Public URL of the backend API as seen from the browser.
# This is baked into the client JS bundle at build time by Vite.
# When deploying, set this to the host where the server is reachable (e.g. http://your-domain.com:3000).
# Docker users: set VITE_API_URL in the root .env file instead; it is forwarded automatically.
VITE_API_URL=http://localhost:3000

# Enable verbose debug logging in the browser console.
# Set to false (or remove) in production.
VITE_DEBUG_MODE=false

# Default theme for first-time visitors (before they change it in settings).
# "auto"  — follows the visitor's OS/browser dark-mode preference (recommended)
# "dark"  — always start in dark mode
# "light" — always start in light mode
VITE_DEFAULT_THEME=auto
